set -e

echo "===================================================="
echo "    TERMUX PRICE ALERT MONITOR - LAUNCHER SCRIPT    "
echo "===================================================="

# Check Termux environment
if [ -z "$TERMUX_VERSION" ] && [[ "$PREFIX" != *"com.termux"* ]] && [ ! -d "/data/data/com.termux" ]; then
    echo "[ERRORE] Questo script e' progettato per funzionare ESCLUSIVAMENTE all'interno di Termux."
    echo "Esecuzione interrotta."
    exit 1
fi

# Ensure Python 3 is installed
if ! command -v python3 &> /dev/null; then
    echo "[INFO] Python 3 non trovato. Installazione via pkg in corso..."
    pkg update -y && pkg install -y python
fi

# Check optional Termux API package for text-to-speech support
if ! command -v termux-tts-speak &> /dev/null; then
    echo "[AVVISO] 'termux-tts-speak' non trovato. Per abilitare la sintesi vocale su Termux,"
    echo "         installa il pacchetto 'termux-api' (pkg install termux-api) e l'app Android Termux:API."
fi

# Ensure required Python packages are available
echo "[INFO] Verifica dipendenze Python (pandas, yfinance, numpy)..."
python3 -c "import pandas, yfinance, numpy" 2>/dev/null || {
    echo "[INFO] Installazione/aggiornamento dipendenze via pip..."
    pip install pandas yfinance numpy
}

echo "[INFO] Avvio di termux_alerts.py in modalita' terminale..."
echo ""

exec python3 termux_alerts.py "$@"

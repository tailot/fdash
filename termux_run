set -e

echo "===================================================="
echo "    TERMUX PRICE ALERT MONITOR - LAUNCHER SCRIPT    "
echo "===================================================="

# Check Termux environment
if [ -z "$TERMUX_VERSION" ] && [[ "$PREFIX" != *"com.termux"* ]] && [ ! -d "/data/data/com.termux" ]; then
    echo "[ERROR] This script is designed to run EXCLUSIVELY inside Termux."
    echo "Execution terminated."
    exit 1
fi

# Ensure Python 3 is installed
if ! command -v python3 &> /dev/null; then
    echo "[INFO] Python 3 not found. Installing via pkg..."
    pkg update -y && pkg install -y python
fi

# Check optional Termux API commands for notifications and background lock screen support
if ! command -v termux-notification &> /dev/null || ! command -v termux-wake-lock &> /dev/null; then
    echo "[NOTICE] 'termux-notification' or 'termux-wake-lock' commands not found."
    echo "         To enable system notifications and background execution when the screen is locked,"
    echo "         install Termux:API (pkg install termux-api) and the Termux:API Android app."
fi

echo "[INFO] Launching termux_alerts.py in terminal mode..."
echo ""

exec python3 termux_alerts.py "$@"
